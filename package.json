{
  "name": "@herdwatch/sentry-cordova",
  "version": "1.7.3-fix.1",
  "main": "dist/js/sentry-cordova.js",
  "types": "dist/js/sentry-cordova.d.ts",
  "license": "MIT",
  "repository": "git://github.com/herdwatch-apps/sentry-cordova.git",
  "homepage": "https://github.com/herdwatch-apps/sentry-cordova#readme",
  "bugs": "https://github.com/herdwatch-apps/sentry-cordova/issues",
  "cordova": {
    "id": "@herdwatch/sentry-cordova",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "keywords": [
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "sentry",
    "debugging",
    "errors",
    "exceptions",
    "logging"
  ],
  "description": "Official Sentry SDK for Cordova",
  "dependencies": {
    "@sentry/browser": "10.70.0",
    "@sentry/cli": "2.43.1",
    "@sentry/core": "10.70.0",
    "@sentry/wizard": "^3.34.2"
  },
  "devDependencies": {
    "@jest/types": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sentry-internal/eslint-config-sdk": "10.57.0",
    "@sentry-internal/typescript": "10.57.0",
    "@types/cordova": "^11.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "json-schema": "^0.4.0",
    "prettier": "^3.9.6",
    "prettier-check": "^2.0.0",
    "replace-in-file": "^9.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "form-data": "4.0.4"
  },
  "scripts": {
    "build:bundle": "rollup --config",
    "build:typescript": "tsc -p tsconfig.build.json",
    "build": "yarn run clean && yarn run build:typescript && yarn run build:bundle",
    "clean": "rimraf dist coverage",
    "jest": "jest",
    "test:watch": "jest --watch",
    "test": "jest",
    "codecov": "codecov",
    "lint": "yarn run lint:prettier && yarn run lint:eslint",
    "lint:prettier": "prettier --check \"{src,test}/**/*.ts\"",
    "lint:eslint": "eslint . --cache --format stylish",
    "fix": "yarn run fix:eslint && yarn run fix:prettier",
    "fix:prettier": "prettier --write \"{src,test}/**/*.ts\"",
    "fix:eslint": "eslint . --format stylish --fix",
    "preversion:changelog": "grep -q -F \"## v$npm_package_version\" CHANGELOG.md",
    "version:all": "yarn run preversion:changelog && yarn run version:bump && yarn run test",
    "version:bump": "node ./scripts/versionbump.js && git add -A",
    "prepack": "scripts/resolve-symlinks.sh"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "collectCoverage": true,
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.json"
        }
      ]
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.d\\.(jsx?|tsx?)$",
      "\\.no-jest\\.(jsx?|tsx?)$"
    ]
  }
}
